<mujoco model="two_link_arm">
  <compiler angle="degree" meshdir="meshes"/>

  <default>
    <default class="arm">
      <geom rgba="0.8 0.2 0.2 1" type="capsule"/>
      <joint damping="1" type="hinge"/>
    </default>
  </default>

  <worldbody>
    <body name="upper_arm" pos="0 0 1">
      <joint name="shoulder" class="arm" axis="0 1 0" range="-90 90"/>
      <geom name="upper_geom" class="arm" fromto="0 0 0 0 0 0.5" size="0.04"/>
      <body name="lower_arm" pos="0 0 0.5">
        <joint name="elbow" class="arm" axis="0 1 0" range="-120 0"/>
        <geom name="lower_geom" class="arm" size="0.04 0.2"/>
        <geom name="hand" type="sphere" size="0.06" pos="0 0 0.4" rgba="0 0.5 1 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
