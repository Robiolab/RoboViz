{
  "name": "roboviz",
  "version": "0.1.0",
  "description": "Robot description file visualizer — MJCF and URDF to browser in one command",
  "license": "MIT",
  "keywords": ["robot", "robotics", "visualization", "mjcf", "urdf", "three.js", "mujoco", "ros2"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "roboviz": "./bin/roboviz.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/client/**",
    "bin/roboviz.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "cd client && npm install && npm run build",
    "prepublishOnly": "npm run build",
    "pack": "npm run build && npm pack",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.22.1",
    "fast-xml-parser": "^5.5.9",
    "open": "^10.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "typescript": "^6.0.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^2.1.9"
  }
}
